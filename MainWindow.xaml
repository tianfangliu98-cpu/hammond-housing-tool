<Window x:Class="FF14HousingKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="哈德蒙的装修工具"
        Icon="/Assets/logo.png"
        Width="540"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="120"
        Top="120"
        FontFamily="Microsoft YaHei UI">

    <Border CornerRadius="14"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.55" />
        </Border.Effect>
        <StackPanel>

            <!-- ===== 标题栏 ===== -->
            <Grid Height="54">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="32" Height="32" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="哈德蒙的装修工具" FontSize="17" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="PinButton" Content="📌" Width="34" Height="30"
                            Style="{StaticResource StepButton}" Click="Pin_Click" ToolTip="窗口置顶" />
                    <Button Content="—" Width="34" Height="30" Style="{StaticResource StepButton}"
                            Margin="6,0,0,0" Click="Minimize_Click" />
                    <Button Content="✕" Width="34" Height="30" Style="{StaticResource StepButton}"
                            Margin="6,0,0,0" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- ===== 工具栏 ===== -->
            <StackPanel Orientation="Horizontal" Margin="18,0,18,10">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FF5A6B80"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" Text="未连接" Foreground="{StaticResource SubTextBrush}" />
                <Button x:Name="ConnectButton" Content="连接游戏" Style="{StaticResource PrimaryButton}"
                        Margin="16,0,0,0" Click="Connect_Click" />
                <Button Content="自检" Style="{StaticResource GhostButton}"
                        Margin="10,0,0,0" Click="Diag_Click" />
            </StackPanel>

            <!-- ===== 模式 / 状态 ===== -->
            <StackPanel Orientation="Horizontal" Margin="18,0,18,12">
                <TextBlock x:Name="ModeText" Text="模式：—" Foreground="{StaticResource SubTextBrush}" />
                <Rectangle Width="1" Height="14" Fill="{StaticResource BorderBrush}" Margin="16,0" />
                <TextBlock x:Name="StateText" Text="状态：—" Foreground="{StaticResource SubTextBrush}" />
            </StackPanel>

            <!-- ===== 位置与旋转 ===== -->
            <Border Margin="18,0" CornerRadius="10" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="◇" Foreground="{StaticResource GoldBrush}" FontSize="15" />
                        <TextBlock Text="位置与旋转" Foreground="{StaticResource GoldBrush}"
                                   FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" />
                        <Rectangle Height="1" Fill="#33C9A227" VerticalAlignment="Center"
                                   Margin="10,0,0,0" HorizontalAlignment="Stretch" Width="220" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- X -->
                        <Border Grid.Row="0" Grid.Column="0" CornerRadius="8"
                                Background="{StaticResource FieldBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,0" Height="46">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="X 东西" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                <TextBox x:Name="XBox" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                         Margin="0,9,8,9" Text="0.000" TextChanged="Coord_TextChanged" />
                                <RepeatButton Grid.Column="2" Content="−" Style="{StaticResource StepRepeatButton}"
                                              Margin="0,9,2,9" Click="XMinus_Click" />
                                <RepeatButton Grid.Column="3" Content="+" Style="{StaticResource StepRepeatButton}"
                                              Margin="5,9,0,9" Click="XPlus_Click" />
                            </Grid>
                        </Border>

                        <!-- Y -->
                        <Border Grid.Row="0" Grid.Column="2" CornerRadius="8"
                                Background="{StaticResource FieldBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,0" Height="46">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Y 高度" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                <TextBox x:Name="YBox" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                         Margin="0,9,8,9" Text="0.000" TextChanged="Coord_TextChanged" />
                                <RepeatButton Grid.Column="2" Content="−" Style="{StaticResource StepRepeatButton}"
                                              Margin="0,9,2,9" Click="YMinus_Click" />
                                <RepeatButton Grid.Column="3" Content="+" Style="{StaticResource StepRepeatButton}"
                                              Margin="5,9,0,9" Click="YPlus_Click" />
                            </Grid>
                        </Border>

                        <!-- Z -->
                        <Border Grid.Row="2" Grid.Column="0" CornerRadius="8"
                                Background="{StaticResource FieldBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,0" Height="46">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Z 南北" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                <TextBox x:Name="ZBox" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                         Margin="0,9,8,9" Text="0.000" TextChanged="Coord_TextChanged" />
                                <RepeatButton Grid.Column="2" Content="−" Style="{StaticResource StepRepeatButton}"
                                              Margin="0,9,2,9" Click="ZMinus_Click" />
                                <RepeatButton Grid.Column="3" Content="+" Style="{StaticResource StepRepeatButton}"
                                              Margin="5,9,0,9" Click="ZPlus_Click" />
                            </Grid>
                        </Border>

                        <!-- 旋转 -->
                        <Border Grid.Row="2" Grid.Column="2" CornerRadius="8"
                                Background="{StaticResource FieldBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,0" Height="46">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="旋转" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                <TextBox x:Name="RotBox" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                         Margin="0,9,8,9" Text="0.0" TextChanged="Coord_TextChanged" />
                                <RepeatButton Grid.Column="2" Content="−" Style="{StaticResource StepRepeatButton}"
                                              Margin="0,9,2,9" Click="RotMinus_Click" />
                                <RepeatButton Grid.Column="3" Content="+" Style="{StaticResource StepRepeatButton}"
                                              Margin="5,9,0,9" Click="RotPlus_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 步长 / 自动应用 / 鼠标穿透 ===== -->
            <Grid Margin="18,14,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="步长" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="StepBox" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                         Width="76" Height="34" Margin="10,0,0,0" Text="0.05" />
                <ToggleButton x:Name="AutoApplyToggle" Grid.Column="2" IsChecked="True"
                              Style="{StaticResource SwitchStyle}" Margin="16,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="自动应用" Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" />

                <CheckBox x:Name="ClickThroughCheck" Grid.Column="4" Content="鼠标穿透"
                          IsChecked="True" Margin="18,0,0,0" VerticalAlignment="Center"
                          Style="{StaticResource DarkCheckBox}"
                          Checked="ClickThrough_Changed" Unchecked="ClickThrough_Changed" />
            </Grid>

            <!-- ===== 解除限制 ===== -->
            <CheckBox x:Name="PlaceAnywhereCheck" Content="解除家具限制" Margin="18,12,18,0"
                      Style="{StaticResource DarkCheckBox}"
                      Checked="PlaceAnywhere_Changed" Unchecked="PlaceAnywhere_Changed" />

            <!-- ===== 透明度 ===== -->
            <Grid Margin="18,14,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="透明度" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="40" Maximum="100" Value="85"
                        Style="{StaticResource DarkSlider}" Margin="12,0" VerticalAlignment="Center"
                        ValueChanged="OpacitySlider_ValueChanged" />
                <TextBlock x:Name="OpacityText" Grid.Column="2" Text="100%"
                           Foreground="{StaticResource TextBrush}" Width="46" TextAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- ===== 清单折叠 ===== -->
            <!-- 家具清单：庭院读数不准（会混入邻居家具），暂时隐藏，后续修好再开 -->
            <Button x:Name="ListToggle" Content="▶   房屋家具清单" Margin="18,14,18,0" Visibility="Collapsed"
                    Height="44" HorizontalContentAlignment="Left" Padding="14,0"
                    Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold"
                    Cursor="Hand" Click="ListToggle_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ===== 清单 ===== -->
            <Border x:Name="ListPanel" Margin="18,8,18,16" Height="280" Visibility="Collapsed"
                    CornerRadius="8" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DataGrid x:Name="FurnitureGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#11FFFFFF"
                          Foreground="{StaticResource TextBrush}" FontSize="12"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FF223144" />
                            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="50" />
                        <DataGridTextColumn Header="家具 ID" Binding="{Binding Id}" Width="70" />
                        <DataGridTextColumn Header="X" Binding="{Binding X}" Width="*" />
                        <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="*" />
                        <DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="*" />
                        <DataGridTextColumn Header="旋转" Binding="{Binding Rot}" Width="60" />
                        <DataGridTextColumn Header="染色" Binding="{Binding Stain}" Width="50" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Height="14" />
        </StackPanel>
    </Border>
</Window>
